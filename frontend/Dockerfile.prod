# Étape 1 : Compilation du Frontend React + TypeScript avec Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Optimisation du cache Docker pour les dépendances
COPY package*.json ./
RUN npm install

# Copie des sources
COPY . .

# Argument pour configurer l'URL d'API si nécessaire (par défaut vide pour utiliser le reverse proxy Nginx relatif)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

# Build de production
RUN npm run build

# Étape 2 : Image d'exécution Nginx ultra-légère
FROM nginx:1.27-alpine

# Installation d'openssl et génération d'un certificat SSL par défaut
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/certs && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/certs/privkey.pem \
    -out /etc/nginx/certs/fullchain.pem \
    -subj "/CN=camfire.local"

# Suppression de la page d'accueil par défaut de Nginx
RUN rm -rf /usr/share/nginx/html/*

# Copie des assets compilés depuis l'étape de build
COPY --from=builder /app/dist /usr/share/nginx/html

# Copie de la configuration Nginx optimisée pour SPA et reverse-proxy FastAPI
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443 5173

# Lancement de Nginx au premier plan
CMD ["nginx", "-g", "daemon off;"]
