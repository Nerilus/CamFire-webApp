# =============================================================================
# CamFire - Configuration de Production (VPS)
# Renommez ou copiez ce fichier vers .env sur votre serveur VPS :
# cp .env.production.example .env
# =============================================================================

# 1. Sécurité de l'application
# Générez une clé aléatoire forte (ex: openssl rand -hex 32)
SECRET_KEY=votre_cle_secrete_ultra_securisee_a_remplacer_obligatoirement
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 2. Base de données PostgreSQL
POSTGRES_USER=camfire_prod_user
POSTGRES_PASSWORD=un_mot_de_passe_robuste_et_complexe_ici
POSTGRES_DB=camfire_prod_db

# 3. Double Authentification & SMTP Email (ex: Gmail ou serveur SMTP pro)
# Pour Gmail, activez la validation 2 étapes et créez un mot de passe d'application sur :
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre_email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=CamFire Security <votre_email@gmail.com>
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10

# 4. Notifications Discord (Optionnel)
# Collez l'URL de votre webhook Discord pour recevoir les alertes incendie / tamper
DISCORD_WEBHOOK_URL=

# 5. Flux Caméra & Provisioning
CAMERA_URL=http://172.20.10.2:8080/
DEVICE_PROVISION_KEY=cf-factory-sec-2026-pi4-prod-key

# 6. Domaines autorisés pour CORS (Optionnel si vous utilisez le reverse-proxy Nginx standard)
# Exemple: https://camfire.mondomaine.com,http://123.45.67.89
CORS_ORIGINS=
