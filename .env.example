# =============================================================================
# Configuration CamFire - Variables d'Environnement
# =============================================================================

# Configuration Email SMTP (Exemple pour Gmail)
# Note : Pour Gmail, générez un mot de passe d'application à 16 caractères sur :
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre_adresse@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=CamFire Security <votre_adresse@gmail.com>
SMTP_USE_TLS=true

# Durée de validité du code de vérification 2FA (en minutes)
OTP_EXPIRE_MINUTES=10
